<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- SEO & Search Engines Tags -->
  <title>louey's Design | تصميم فساتين سهرة فاخرة وهوت كوتور</title>
  <meta name="description" content="دار louey's Design المتخصصة في أرقى وأفخم فساتين السهرة الفاخرة والتطريز اليدوي الهوت كوتور. تأنّقي كالملكات في كل مناسبة." />
  <meta name="keywords" content="louey design, فساتين سهرة, فساتين فاخرة, أزياء سهرة, تصاميم فساتين, هوت كوتور, فستان سهرة ملوكي, دار أزياء" />
  <meta name="robots" content="index, follow" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            gold: {
              300: '#fcf6ba',
              400: '#fbf5b7',
              500: '#d4af37',
              600: '#aa771c',
            },
            dark: {
              700: '#262626',
              800: '#171717',
              900: '#0a0a0a',
              950: '#050505',
            }
          }
        }
      }
    }
  </script>

  <style>
    body { font-family: 'Tajawal', sans-serif; background-color: #050505; color: #e5e5e5; }
    .serif-title { font-family: 'Amiri', serif; }
    .gold-text-gradient { 
      background: linear-gradient(135deg, #bf953f 0%, #fcf6ba 25%, #b38728 50%, #fbf5b7 75%, #aa771c 100%); 
      -webkit-background-clip: text; 
      -webkit-text-fill-color: transparent; 
    }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #0a0a0a; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #ca8a04; border-radius: 3px; }
  </style>
</head>
<body class="bg-dark-950 text-gray-200 min-h-screen flex flex-col justify-between selection:bg-gold-500 selection:text-dark-950">

  <!-- شريط المالك العلوي -->
  <div id="adminToolbar" class="hidden sticky top-0 z-50 bg-gradient-to-r from-amber-950 via-amber-900 to-amber-950 text-white text-xs py-2 px-4 shadow-lg border-b border-gold-500/40 flex justify-between items-center">
    <div class="flex items-center gap-2 font-bold">
      <i class="fa-solid fa-user-shield text-gold-400"></i>
      <span data-i18n="admin_toolbar_title">وضع المالك مفعل — يمكنك إدارة مئات القطع والصور وتحديث البيانات</span>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="openAdminModal(true)" class="bg-dark-900 hover:bg-black text-gold-400 border border-gold-500/40 px-3 py-1 rounded transition font-medium">
        <i class="fa-solid fa-sliders ml-1"></i> <span data-i18n="admin_settings_btn">إعدادات الموقع ورفع الصور</span>
      </button>
      <button onclick="logoutAdmin()" class="bg-red-950 hover:bg-red-900 border border-red-800/50 text-red-300 px-3 py-1 rounded transition">
        <i class="fa-solid fa-right-from-bracket ml-1"></i> <span data-i18n="admin_logout_btn">تسجيل الخروج</span>
      </button>
    </div>
  </div>

  <!-- خلفية نمطية ديناميكية -->
  <div id="dynamicBgOverlay" class="fixed inset-0 z-0 opacity-20 pointer-events-none bg-cover bg-center transition-all duration-700"></div>
  <div class="fixed inset-0 z-0 opacity-25 pointer-events-none bg-[radial-gradient(#ca8a04_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <!-- الهيدر -->
  <header class="sticky top-0 z-40 bg-dark-900/90 backdrop-blur-md border-b border-gold-600/20 shadow-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <div class="flex items-center space-x-3 space-x-reverse">
          <i class="fa-solid fa-crown text-gold-400 text-2xl"></i>
          <span id="siteBrand" class="serif-title text-2xl md:text-3xl font-bold gold-text-gradient tracking-wide cursor-pointer" onclick="scrollToTop()">louey's Design</span>
        </div>
        <nav class="hidden md:flex space-x-8 space-x-reverse text-sm font-medium">
          <a href="#hero" data-i18n="nav_home" class="text-gray-300 hover:text-gold-400 transition">الرئيسية</a>
          <a href="#gallery" data-i18n="nav_gallery" class="text-gray-300 hover:text-gold-400 transition">المعرض الشامل</a>
          <a href="#features" data-i18n="nav_features" class="text-gray-300 hover:text-gold-400 transition">مميزات الدار</a>
          <a href="#about" data-i18n="nav_about" class="text-gray-300 hover:text-gold-400 transition">عن الدار</a>
          <a href="#contact" data-i18n="nav_contact" class="text-gray-300 hover:text-gold-400 transition">تواصل معنا</a>
        </nav>

        <div class="flex items-center gap-3">
          <button onclick="shareWebsiteLink()" class="text-xs bg-dark-800 hover:bg-gold-600/20 text-gold-400 px-3 py-1.5 rounded-full border border-gold-600/30 transition flex items-center gap-1">
            <i class="fa-solid fa-share-nodes"></i> <span data-i18n="btn_share" class="hidden sm:inline">مشاركة الرابط</span>
          </button>

          <div class="flex items-center bg-dark-800 border border-dark-700 rounded-full p-1 text-xs">
            <button onclick="setLanguage('ar')" id="lang-ar" class="px-2.5 py-1 rounded-full text-gold-400 font-bold transition">AR</button>
            <button onclick="setLanguage('en')" id="lang-en" class="px-2.5 py-1 rounded-full text-gray-400 transition">EN</button>
            <button onclick="setLanguage('tr')" id="lang-tr" class="px-2.5 py-1 rounded-full text-gray-400 transition">TR</button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- القسم الرئيسي (Hero) -->
  <section id="hero" class="relative z-10 pt-16 pb-12 md:pt-20 md:pb-16 overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 text-center relative">
      <div class="inline-block mb-4">
        <span data-i18n="hero_tag" class="text-gold-400 text-xs md:text-sm tracking-widest uppercase font-semibold border-b border-gold-500/40 pb-1 px-4">دار أزياء فساتين السهرة الفاخرة</span>
      </div>
      <h1 id="heroTitle" class="serif-title text-4xl sm:text-6xl md:text-7xl font-bold text-white mb-6 leading-tight drop-shadow-md">louey's Design</h1>
      <p id="heroSubtitle" data-i18n="hero_subtitle" class="text-lg sm:text-2xl text-gray-300 font-light max-w-3xl mx-auto leading-relaxed italic border-x border-gold-500/20 px-6 py-2">"تأنّقي كالملكات.. تصميم يلامس روحك ويبرز جمالك الساحر في كل مناسبة."</p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#gallery" class="w-full sm:w-auto bg-gradient-to-r from-gold-600 via-gold-500 to-gold-600 text-dark-950 font-bold px-8 py-3.5 rounded-full shadow-lg shadow-gold-600/20 hover:from-gold-500 hover:to-gold-400 transform hover:-translate-y-0.5 transition duration-300 text-sm">
          <i class="fa-solid fa-gem ml-2"></i> <span data-i18n="btn_explore">استعرضي المعرض الشامل الآن</span>
        </a>
        <a id="designerConsultationBtn" href="#" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto bg-green-950/80 hover:bg-green-900 text-green-400 border border-green-600/40 font-bold px-8 py-3.5 rounded-full transition duration-300 text-sm flex items-center justify-center gap-2">
          <i class="fa-brands fa-whatsapp text-lg"></i> <span data-i18n="btn_consultation">استشارة خاصة وحجز مقاسات عبر الواتساب</span>
        </a>
      </div>
    </div>
  </section>

  <!-- شريط الخيارين الخاصين للتواصل السريع والتحويل للواتساب -->
  <section class="relative z-10 border-y border-dark-800 bg-dark-900/60 py-6">
    <div class="max-w-4xl mx-auto px-4 grid grid-cols-1 sm:grid-cols-2 gap-4 text-center">
      <!-- خيار 1: تفصيل حسب المقاس -->
      <a id="featureCustomSizeBtn" href="#" target="_blank" class="p-4 bg-dark-950/80 rounded-2xl border border-gold-600/30 hover:border-gold-500 hover:-translate-y-1 transition group shadow-lg flex flex-col items-center">
        <div class="w-12 h-12 bg-gold-600/10 text-gold-400 rounded-full flex items-center justify-center text-xl mb-2 border border-gold-500/30 group-hover:scale-110 transition">
          <i class="fa-solid fa-ruler-combined"></i>
        </div>
        <h4 data-i18n="feat_custom_size_title" class="text-lg font-bold text-white group-hover:text-gold-400 transition">تفصيل حسب المقاس الخاص</h4>
        <p data-i18n="feat_custom_size_desc" class="text-xs text-gray-400 mt-1">اضغطي هنا لحجز مقاساتك بدقة والتواصل مع الخياط مباشرة عبر الواتساب</p>
        <span data-i18n="click_to_wa" class="inline-block mt-2 text-[11px] text-green-400 font-bold"><i class="fa-brands fa-whatsapp text-sm ml-1"></i> تواصل عبر الواتساب</span>
      </a>

      <!-- خيار 2: استشارة خاصة -->
      <a id="featureConsultationBtn" href="#" target="_blank" class="p-4 bg-dark-950/80 rounded-2xl border border-gold-600/30 hover:border-gold-500 hover:-translate-y-1 transition group shadow-lg flex flex-col items-center">
        <div class="w-12 h-12 bg-gold-600/10 text-gold-400 rounded-full flex items-center justify-center text-xl mb-2 border border-gold-500/30 group-hover:scale-110 transition">
          <i class="fa-solid fa-comments"></i>
        </div>
        <h4 data-i18n="feat_consultation_title" class="text-lg font-bold text-white group-hover:text-gold-400 transition">استشارة أزياء خاصة</h4>
        <p data-i18n="feat_consultation_desc" class="text-xs text-gray-400 mt-1">احصلي على استشارة مخصصة لاختيار الفستان الأنسب لمناسبتك عبر الواتساب</p>
        <span data-i18n="click_to_wa" class="inline-block mt-2 text-[11px] text-green-400 font-bold"><i class="fa-brands fa-whatsapp text-sm ml-1"></i> تواصل عبر الواتساب</span>
      </a>
    </div>
  </section>

  <!-- المعرض الشامل الفاخر (Mega Gallery) -->
  <main id="gallery" class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow">
    <div class="text-center mb-8">
      <h2 data-i18n="section_gallery_title" class="serif-title text-3xl sm:text-5xl font-bold text-white mb-3">المعرض الشامل والقطع الحصرية</h2>
      <p data-i18n="section_gallery_desc" class="text-xs sm:text-sm text-gray-400 max-w-lg mx-auto">تصفحي مئات القطع المصممة بأعلى معايير الهوت كوتور. اضغطي على أي قطعة لمعاينة كافة الصور والتطريز عن قرب.</p>
      <div class="w-32 h-0.5 bg-gradient-to-r from-transparent via-gold-500 to-transparent mx-auto mt-4"></div>
    </div>

    <!-- أداة البحث والتصفية الذكية -->
    <div class="max-w-4xl mx-auto mb-10 space-y-4">
      <!-- شريط البحث -->
      <div class="relative">
        <input type="text" id="searchInput" oninput="filterDresses()" placeholder="ابحثي عن فستان، لون، أو قماش (مثال: ذهبي، مخمل، ملكي)..." data-i18n-ph="search_placeholder" class="w-full bg-dark-900 border border-gold-600/30 rounded-full py-3.5 pr-12 pl-4 text-xs sm:text-sm text-white focus:outline-none focus:border-gold-500 shadow-xl transition placeholder-gray-500">
        <i class="fa-solid fa-magnifying-glass absolute top-4 right-4 text-gold-400 text-base"></i>
      </div>

      <!-- أزرار التصنيف السريع -->
      <div class="flex items-center justify-center gap-2 overflow-x-auto pb-2 custom-scrollbar text-xs">
        <button onclick="filterCategory('all', this)" class="cat-btn active bg-gold-600 text-dark-950 font-bold px-4 py-2 rounded-full border border-gold-500 transition whitespace-nowrap" data-i18n="cat_all">الكل</button>
        <button onclick="filterCategory('royal', this)" class="cat-btn bg-dark-900 text-gray-300 hover:text-gold-400 px-4 py-2 rounded-full border border-dark-800 transition whitespace-nowrap" data-i18n="cat_royal">الملكي الفاخر</button>
        <button onclick="filterCategory('velvet', this)" class="cat-btn bg-dark-900 text-gray-300 hover:text-gold-400 px-4 py-2 rounded-full border border-dark-800 transition whitespace-nowrap" data-i18n="cat_velvet">المخمل</button>
        <button onclick="filterCategory('satin', this)" class="cat-btn bg-dark-900 text-gray-300 hover:text-gold-400 px-4 py-2 rounded-full border border-dark-800 transition whitespace-nowrap" data-i18n="cat_satin">الساتان والحرير</button>
      </div>
    </div>

    <div id="quickAddDressBtn" class="hidden mb-8 text-center">
      <button onclick="openAdminModal(true)" class="bg-gold-600/20 hover:bg-gold-600/30 text-gold-400 border border-gold-500/50 font-bold px-6 py-2.5 rounded-full text-xs transition inline-flex items-center gap-2 shadow-lg">
        <i class="fa-solid fa-plus-circle text-base"></i> <span data-i18n="btn_add_dress_quick">إضافة فستان جديد أو رفع مئات الصور جملة</span>
      </button>
    </div>

    <!-- شبكة فائقة الاستيعاب لرفع وعرض مئات الفساتين والصور -->
    <div id="dressesGrid" class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6 gap-4 sm:gap-6" aria-live="polite"></div>
    
    <div id="noResultsMsg" class="hidden text-center py-16">
      <i class="fa-solid fa-box-open text-gray-600 text-4xl mb-3"></i>
      <p data-i18n="no_results" class="text-sm text-gray-400">لم نجد أي قطعة تطابق بحثك حالياً.</p>
    </div>
  </main>

  <!-- مميزات وتجارب الدار -->
  <section id="features" class="relative z-10 bg-dark-900/60 border-y border-dark-800 py-16">
    <div class="max-w-7xl mx-auto px-4 space-y-12">
      <div class="text-center">
        <h3 data-i18n="why_choose_title" class="serif-title text-3xl font-bold text-white">لماذا تختارين louey's Design؟</h3>
        <p data-i18n="why_choose_subtitle" class="text-xs text-gray-400 mt-2">نهتم بأدق التفاصيل لتكوني أيقونة الجمال في كل مناسبة</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-dark-950 p-6 rounded-2xl border border-dark-800 space-y-3">
          <div class="w-12 h-12 bg-gold-600/10 text-gold-400 rounded-xl flex items-center justify-center text-xl font-bold"><i class="fa-solid fa-gem"></i></div>
          <h4 data-i18n="why_card1_title" class="text-lg font-bold text-white">أقمشة ومواد فاخرة</h4>
          <p data-i18n="why_card1_desc" class="text-xs text-gray-400 leading-relaxed">نستورد الحرير الطبيعي، الدانتيل الفرنسي، والمخمل الملكي من أفضل الموردين العالميين ضماناً للمس المتميز والرقي.</p>
        </div>
        <div class="bg-dark-950 p-6 rounded-2xl border border-dark-800 space-y-3">
          <div class="w-12 h-12 bg-gold-600/10 text-gold-400 rounded-xl flex items-center justify-center text-xl font-bold"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
          <h4 data-i18n="why_card2_title" class="text-lg font-bold text-white">تعديلات خاصة واستشارة</h4>
          <p data-i18n="why_card2_desc" class="text-xs text-gray-400 leading-relaxed">فريقنا المصمم متواجد لتقديم الاستشارة وتعديل الفستان ليكون مناسباً لشكلك ومقاسك بالضبط عبر الواتساب.</p>
        </div>
        <div class="bg-dark-950 p-6 rounded-2xl border border-dark-800 space-y-3">
          <div class="w-12 h-12 bg-gold-600/10 text-gold-400 rounded-xl flex items-center justify-center text-xl font-bold"><i class="fa-solid fa-box-open"></i></div>
          <h4 data-i18n="why_card3_title" class="text-lg font-bold text-white">تغليف ملوكي آمن</h4>
          <p data-i18n="why_card3_desc" class="text-xs text-gray-400 leading-relaxed">يصلك الفستان داخل صندوق فاخر مع حماية كاملة للتطريز لتستلميه كهدية ملكية تليق بك.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- عن الدار -->
  <section id="about" class="relative z-10 py-16">
    <div class="max-w-5xl mx-auto px-4 text-center space-y-6">
      <h3 data-i18n="about_title" class="serif-title text-3xl font-bold gold-text-gradient">عن دار louey's Design</h3>
      <p data-i18n="about_desc" class="text-gray-300 text-sm md:text-base leading-relaxed max-w-3xl mx-auto">
        نحن في دار <strong>louey's Design</strong> نؤمن بأن كل امرأة هي قطعة فنية مميزة تستحق تصميماً يُبرز فخامتها وأنوثتها. نبتكر أزياء السهرة بحرفية عالية ودقة متناهية بالاعتماد على أفضل أنواع الأقمشة العالمية والتطريز اليدوي الفاخر.
      </p>
    </div>
  </section>

  <!-- التذييل -->
  <footer id="contact" class="relative z-10 bg-dark-900 border-t border-dark-800 text-gray-400 py-12">
    <div class="max-w-7xl mx-auto px-4 text-center space-y-6">
      <div class="flex items-center justify-center space-x-2 space-x-reverse cursor-pointer select-none" onclick="handleSecretClick()" role="button" aria-label="لوحة إدارة الدار">
        <i class="fa-solid fa-crown text-gold-400"></i>
        <span id="secretTriggerBrand" class="serif-title text-2xl font-bold gold-text-gradient hover:opacity-90">louey's Design</span>
      </div>
      <p class="text-xs text-gray-500"><span data-i18n="footer_rights">جميع الحقوق محفوظة &copy;</span> <span id="year"></span> | louey's Design</p>

      <div class="flex justify-center space-x-6 space-x-reverse text-gold-400 pt-2">
        <a id="socialInstagram" href="#" target="_blank" rel="noopener noreferrer" class="hover:text-gold-300 transition text-2xl" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
        <a id="socialFacebook" href="#" target="_blank" rel="noopener noreferrer" class="hover:text-gold-300 transition text-2xl" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
        <a id="socialWhatsapp" href="#" target="_blank" rel="noopener noreferrer" class="hover:text-gold-300 transition text-2xl" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
      </div>
    </div>
  </footer>

  <!-- نافذة تفاصيل الفستان ومعرض الصور التفاعلي (Dress Detail Modal) -->
  <div id="dressDetailModal" class="fixed inset-0 bg-black/90 backdrop-blur-md z-50 hidden flex items-center justify-center p-2 sm:p-4 overflow-y-auto" role="dialog" aria-modal="true">
    <div class="bg-dark-900 border border-gold-600/40 rounded-2xl max-w-4xl w-full relative shadow-2xl overflow-hidden my-auto max-h-[95vh] flex flex-col md:flex-row">
      <button onclick="closeDressDetailModal()" class="absolute top-4 left-4 z-20 bg-dark-950/80 text-gray-400 hover:text-white p-2 rounded-full border border-gold-500/30 text-lg transition" aria-label="إغلاق"><i class="fa-solid fa-xmark"></i></button>

      <!-- معرض الصور المتعددة -->
      <div class="md:w-1/2 bg-dark-950 p-4 flex flex-col justify-between border-b md:border-b-0 md:border-l border-dark-800">
        <div class="relative h-80 md:h-[420px] rounded-xl overflow-hidden mb-3 group">
          <img id="modalMainImg" src="" alt="صورة الفستان الرئيسية" class="w-full h-full object-cover object-top transition duration-500">
          <span id="modalDetailPrice" class="absolute top-3 right-3 bg-dark-950/80 backdrop-blur-md text-gold-400 font-bold px-3 py-1 rounded-full text-xs border border-gold-500/30"></span>
        </div>
        <!-- الصور المصغرة -->
        <div id="modalThumbnails" class="flex gap-2 overflow-x-auto pb-2 custom-scrollbar"></div>
      </div>

      <!-- تفاصيل الخيارات والطلب -->
      <div class="md:w-1/2 p-6 flex flex-col justify-between space-y-4 overflow-y-auto custom-scrollbar">
        <div>
          <span data-i18n="tag_exclusive" class="text-[10px] text-gold-400 font-semibold tracking-widest uppercase border-b border-gold-500/30 pb-0.5">تصميم حصري</span>
          <h3 id="modalDetailTitle" class="serif-title text-2xl md:text-3xl font-bold text-white mt-2"></h3>
          <p id="modalDetailDesc" class="text-xs text-gray-400 leading-relaxed mt-3"></p>
        </div>

        <!-- اختيار المقاس -->
        <div class="space-y-2">
          <label class="block text-xs text-gold-400 font-bold"><i class="fa-solid fa-ruler-vertical ml-1"></i> <span data-i18n="label_choose_size">اختاري المقاس المناسب:</span></label>
          <div class="flex flex-wrap gap-2 text-xs" id="sizeSelector">
            <button type="button" onclick="selectSize('XS', this)" class="size-btn px-3 py-1.5 rounded-lg border border-dark-700 bg-dark-950 text-gray-300 hover:border-gold-500">XS</button>
            <button type="button" onclick="selectSize('S', this)" class="size-btn px-3 py-1.5 rounded-lg border border-dark-700 bg-dark-950 text-gray-300 hover:border-gold-500">S</button>
            <button type="button" onclick="selectSize('M', this)" class="size-btn px-3 py-1.5 rounded-lg border border-gold-500 bg-gold-600/20 text-gold-400 font-bold">M</button>
            <button type="button" onclick="selectSize('L', this)" class="size-btn px-3 py-1.5 rounded-lg border border-dark-700 bg-dark-950 text-gray-300 hover:border-gold-500">L</button>
            <button type="button" onclick="selectSize('XL', this)" class="size-btn px-3 py-1.5 rounded-lg border border-dark-700 bg-dark-950 text-gray-300 hover:border-gold-500">XL</button>
            <button type="button" onclick="selectSize('مقاس خاص', this)" class="size-btn px-3 py-1.5 rounded-lg border border-dark-700 bg-dark-950 text-gray-300 hover:border-gold-500" data-i18n="size_custom">مقاس خاص</button>
          </div>
        </div>

        <!-- اختيار اللون إن وجد -->
        <div class="space-y-2">
          <label class="block text-xs text-gold-400 font-bold"><i class="fa-solid fa-palette ml-1"></i> <span data-i18n="label_color">اللون المختار:</span></label>
          <div id="colorSelector" class="flex gap-2 text-xs">
            <span data-i18n="color_original" class="px-3 py-1 bg-dark-950 rounded-lg border border-gold-500/40 text-gray-200">اللون الأصلي كما بالصورة</span>
          </div>
        </div>

        <!-- معلومات التحويل والطلب -->
        <div class="pt-4 border-t border-dark-800 space-y-3">
          <button onclick="proceedToPaymentFromDetail()" class="w-full bg-gradient-to-r from-gold-600 to-gold-500 text-dark-950 font-bold py-3 rounded-xl hover:from-gold-500 hover:to-gold-400 transition text-sm flex items-center justify-center gap-2 shadow-lg">
            <i class="fa-solid fa-credit-card"></i> <span data-i18n="btn_proceed_order">الانتقال لإتمام الطلب والتحويل</span>
          </button>
          <a id="modalDetailWaBtn" href="#" target="_blank" class="block w-full text-center bg-green-950/80 hover:bg-green-900 text-green-400 border border-green-600/40 font-bold py-2.5 rounded-xl transition text-xs">
            <i class="fa-brands fa-whatsapp text-sm ml-1"></i> <span data-i18n="btn_consult_wa_modal">استشارة المصمم مباشرة حول هذا الفستان</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- نافذة الدفع بالـ IBAN -->
  <div id="paymentModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 hidden flex items-center justify-center p-4" role="dialog" aria-modal="true">
    <div class="bg-dark-900 border border-gold-600/40 rounded-2xl p-6 sm:p-8 max-w-lg w-full relative shadow-2xl">
      <button onclick="closePaymentModal()" class="absolute top-4 left-4 text-gray-400 hover:text-white text-xl" aria-label="اغلاق"><i class="fa-solid fa-xmark"></i></button>

      <div class="text-center mb-6">
        <div class="w-12 h-12 bg-gold-600/10 text-gold-400 rounded-full flex items-center justify-center mx-auto text-xl border border-gold-500/30 mb-3">
          <i class="fa-solid fa-building-columns"></i>
        </div>
        <h3 data-i18n="modal_payment_title" class="serif-title text-2xl font-bold text-white">إتمام طلب الفستان</h3>
        <p id="modalDressTitle" class="text-gold-400 text-sm font-semibold mt-1"></p>
        <p id="selectedSizeDisplay" class="text-xs text-gray-400 mt-0.5"></p>
        <div class="mt-2 inline-block bg-dark-800 px-4 py-1 rounded-full border border-gold-500/30">
          <span data-i18n="price_label" class="text-xs text-gray-400">السعر:</span>
          <span id="modalDressPrice" class="text-gold-400 font-bold ml-1"></span> <span class="text-xs text-gold-400">USD $</span>
        </div>
      </div>

      <div class="space-y-4">
        <div class="bg-dark-950 p-4 rounded-xl border border-gold-600/30 space-y-3">
          <p data-i18n="iban_msg" class="text-xs text-gray-400">يرجى تحويل المبلغ بالدولار الأمريكي (USD) إلى حساب الآيبان الخاص بالدار:</p>
          
          <div class="flex items-center justify-between bg-dark-900 p-3 rounded-lg border border-dark-700">
            <span id="displayIban" class="font-mono text-xs sm:text-sm text-gold-400 font-bold tracking-wider"></span>
            <button onclick="copyIban()" class="text-xs bg-gold-600/20 text-gold-400 hover:bg-gold-600/40 px-3 py-1.5 rounded transition flex items-center gap-1">
              <i class="fa-regular fa-copy"></i> <span data-i18n="btn_copy">نسخ</span>
            </button>
          </div>

          <div class="flex justify-between items-center text-xs pt-1 border-t border-dark-800">
            <span data-i18n="required_amount" class="text-gray-400">المبلغ المطلوب للتحويل:</span>
            <span class="text-gold-400 font-bold"><span id="ibanDressPrice"></span> USD $</span>
          </div>
        </div>

        <a id="whatsappIbanBtn" href="#" target="_blank" rel="noopener noreferrer" class="block w-full text-center bg-green-600 hover:bg-green-500 text-white font-bold py-3.5 rounded-xl transition text-sm shadow-md">
          <i class="fa-brands fa-whatsapp text-lg ml-1"></i> <span data-i18n="btn_confirm_wa">تأكيد الطلب وإرسال التحويل عبر الواتساب</span>
        </a>
      </div>
    </div>
  </div>

  <!-- لوحة تحكم المالك السريّة السريعة للجملة -->
  <div id="adminModal" class="fixed inset-0 bg-black/95 backdrop-blur-md z-50 hidden flex items-center justify-center p-4" role="dialog" aria-modal="true">
    <div class="bg-dark-900 border border-gold-500/50 rounded-2xl p-6 max-w-3xl w-full max-h-[90vh] overflow-y-auto custom-scrollbar relative shadow-2xl">
      <button onclick="closeAdminModal()" class="absolute top-4 left-4 text-gray-400 hover:text-white text-xl" aria-label="اغلاق"><i class="fa-solid fa-xmark"></i></button>

      <!-- تسجيل الدخول -->
      <div id="adminLoginView" class="py-10 text-center space-y-4">
        <div class="w-16 h-16 bg-gold-600/10 text-gold-400 rounded-full flex items-center justify-center mx-auto text-2xl border border-gold-500/30"><i class="fa-solid fa-user-shield"></i></div>
        <h3 class="serif-title text-2xl font-bold text-white">تسجيل دخول المالك</h3>
        <p class="text-xs text-gray-400">أدخل كلمة السر الخاصة للوصول إلى لوحة تحكم المتجر.</p>

        <form id="adminLoginForm" class="max-w-xs mx-auto space-y-3 pt-2" onsubmit="handleAdminLogin(event)">
          <input id="adminPassInput" type="password" placeholder="كلمة السر" required class="w-full bg-dark-950 border border-dark-700 rounded-lg px-3 py-2.5 text-white focus:outline-none focus:border-gold-500 text-sm text-center">
          <button type="submit" class="w-full bg-gold-500 text-dark-950 font-bold py-2.5 rounded-lg hover:bg-gold-400 transition text-sm">تسجيل الدخول</button>
          <p id="adminErrorMsg" class="text-xs text-red-500 hidden font-bold">كلمة السر غير صحيحة!</p>
        </form>
      </div>

      <!-- واجهة الداشبورد -->
      <div id="adminDashboardView" class="hidden space-y-6">
        <div class="flex justify-between items-center border-b border-dark-700 pb-4">
          <div>
            <h3 class="serif-title text-xl font-bold text-gold-400">لوحة تحكم المالك - louey's Design</h3>
            <p class="text-xs text-gray-400">رفع مئات الصور دفعة واحدة، إضافة الفساتين وتحديث الإعدادات.</p>
          </div>
          <button onclick="logoutAdmin()" class="text-xs bg-red-950/80 border border-red-800/40 text-red-400 hover:bg-red-900 px-3 py-1.5 rounded transition">تسجيل الخروج</button>
        </div>

        <!-- السلاح الفتاك: أداة رفع واستيراد مئات الصور بنقرة واحدة -->
        <div class="bg-gradient-to-r from-dark-950 via-amber-950/30 to-dark-950 p-5 rounded-xl border border-gold-500/40 space-y-4">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-bolt text-gold-400 text-lg"></i>
            <p class="text-xs font-bold text-gold-400">أداة الرفع الفتاكة السريعة (توليد مئات الفساتين تلقائياً من الصور):</p>
          </div>
          <p class="text-[11px] text-gray-400">حددي عشرات أو مئات الصور من جهازك مرة واحدة، وسيقوم النظام بتكوين فساتين منفصلة لها في المعرض فوراً!</p>
          <label class="cursor-pointer bg-gradient-to-r from-gold-600 to-gold-500 text-dark-950 font-bold text-xs py-3 px-6 rounded-xl block text-center shadow-lg hover:brightness-110 transition">
            <i class="fa-solid fa-cloud-arrow-up text-base ml-1"></i> رفع مئات الصور دفعة واحدة المعرض
            <input type="file" id="bulkImagesInput" accept="image/*" multiple class="hidden" onchange="handleBulkImagesUpload(event)">
          </label>
        </div>

        <!-- إضافة فستان واحد فردي بجميع تفاصيله -->
        <div class="bg-dark-950 p-4 rounded-xl border border-dark-800 space-y-4">
          <p class="text-xs font-bold text-gold-400 flex items-center gap-1"><i class="fa-solid fa-plus-circle"></i> إضافة فستان محدد بالتفصيل:</p>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <input id="newDressNameAr" type="text" placeholder="اسم الفستان (عربي)" class="bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white">
            <input id="newDressNameEn" type="text" placeholder="Dress Name (English)" class="bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white">
            <input id="newDressNameTr" type="text" placeholder="Elbise Adı (Türkçe)" class="bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white">
          </div>

          <div class="grid grid-cols-1 gap-2">
            <input id="newDressPrice" type="number" placeholder="السعر بالدولار ($ USD)" class="bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white">
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <textarea id="newDressDescAr" placeholder="الوصف (عربي)..." class="bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white h-16"></textarea>
            <textarea id="newDressDescEn" placeholder="Description (English)..." class="bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white h-16"></textarea>
            <textarea id="newDressDescTr" placeholder="Açıklama (Türkçe)..." class="bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white h-16"></textarea>
          </div>
          
          <div class="space-y-2">
            <label class="block text-xs text-gray-400">صور هذا الفستان المحدد (صورة أو أكثر):</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <label class="cursor-pointer bg-dark-800 hover:bg-dark-700 text-gold-400 border border-gold-600/30 text-xs px-3 py-2 rounded font-bold flex items-center justify-center gap-2">
                <i class="fa-solid fa-images"></i> رفع صور الفستان
                <input type="file" id="newDressFileInput" accept="image/*" multiple class="hidden" onchange="handleDressMultiFilesSelect(event)">
              </label>
              <input id="newDressImage" type="text" placeholder="أو أدخل رابط الصورة الرئيسية (URL)" class="bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white">
            </div>
            <p id="selectedFileName" class="text-[10px] text-green-400 mt-1"></p>
          </div>

          <button onclick="addNewDress()" class="w-full bg-gold-600 hover:bg-gold-500 text-dark-950 text-xs font-bold py-2.5 rounded transition shadow">
            <i class="fa-solid fa-check ml-1"></i> إضافة الفستان للتصاميم
          </button>
        </div>

        <!-- تغيير كلمة السر -->
        <div class="bg-dark-950 p-4 rounded-xl border border-dark-800 space-y-3">
          <p class="text-xs font-bold text-gold-400 flex items-center gap-1"><i class="fa-solid fa-key"></i> تغيير كلمة سر المالك:</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <input id="oldPasswordInput" type="password" placeholder="كلمة السر الحالية" class="bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white">
            <input id="newPasswordInput" type="password" placeholder="كلمة السر الجديدة" class="bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white">
          </div>
          <button onclick="changeAdminPassword()" class="bg-gold-600 hover:bg-gold-500 text-dark-950 text-xs font-bold px-4 py-2 rounded transition shadow">
            تحديث كلمة السر
          </button>
        </div>

        <!-- إعدادات الموقع العامة -->
        <div class="bg-dark-950 p-4 rounded-xl border border-dark-800 space-y-4">
          <p class="text-xs font-bold text-gold-400 flex items-center gap-1"><i class="fa-solid fa-gear"></i> الإعدادات العامة والحسابات:</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div><label class="block text-xs text-gray-400 mb-1">اسم الموقع/الدار</label><input id="settingSiteTitle" type="text" class="w-full bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white"></div>
            <div><label class="block text-xs text-gray-400 mb-1">رقم IBAN للتحويلات</label><input id="settingIban" type="text" class="w-full bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white"></div>
          </div>
          <div><label class="block text-xs text-gray-400 mb-1">عبارة الترحيب في الرئيسية</label><input id="settingSubtitle" type="text" class="w-full bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white"></div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div><label class="block text-xs text-gray-400 mb-1"><i class="fab fa-whatsapp text-green-500"></i> رقم الواتساب</label><input id="settingWhatsapp" type="text" class="w-full bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white"></div>
            <div><label class="block text-xs text-gray-400 mb-1"><i class="fab fa-instagram text-pink-500"></i> رابط انستغرام</label><input id="settingInstagram" type="text" class="w-full bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white"></div>
            <div><label class="block text-xs text-gray-400 mb-1"><i class="fab fa-facebook text-blue-500"></i> رابط فيسبوك</label><input id="settingFacebook" type="text" class="w-full bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white"></div>
          </div>

          <div>
            <label class="block text-xs text-gray-400 mb-1">صورة خلفية الموقع:</label>
            <div class="flex gap-2">
              <input id="settingBgUrl" type="text" class="w-full bg-dark-900 border border-dark-700 rounded px-3 py-2 text-xs text-white" placeholder="https://...">
              <label class="cursor-pointer bg-dark-800 hover:bg-dark-700 text-gold-400 border border-gold-600/30 text-xs px-3 py-2 rounded font-bold whitespace-nowrap">
                رفع خلفية <input type="file" accept="image/*" class="hidden" onchange="handleBgFileUpload(event)">
              </label>
            </div>
          </div>

          <button onclick="saveGeneralSettings()" class="bg-gold-600 hover:bg-gold-500 text-dark-950 text-xs font-bold px-5 py-2 rounded transition shadow">حفظ التغييرات</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentLang = 'ar';
