    function setLanguage(lang) {
      currentLang = lang;
      const data = i18nData[lang] || i18nData.ar;
      
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (data[key]) el.textContent = data[key];
      });

      document.dir = lang === 'ar' ? 'rtl' : 'ltr';
      document.documentElement.lang = lang;

      ['ar','en','tr'].forEach(l => {
        const b = document.getElementById(`lang-${l}`);
        if(b) b.className = l === lang ? "px-2.5 py-1 rounded-full text-gold-400 font-bold transition" : "px-2.5 py-1 rounded-full text-gray-400 transition";
      });

      renderData();
    }

    function scrollToTop() { window.scrollTo({ top: 0, behavior: 'smooth' }); }

    function getDressField(fieldObj) {
      if (typeof fieldObj === 'object' && fieldObj !== null) {
        return fieldObj[currentLang] || fieldObj['ar'] || fieldObj['en'] || '';
      }
      return fieldObj || '';
    }

    function safeCreateDressCard(dress) {
      const card = document.createElement('div');
      card.className = "bg-dark-900 rounded-xl overflow-hidden border border-dark-800 hover:border-gold-600/40 transition-all duration-300 flex flex-col justify-between group shadow-lg hover:-translate-y-1 relative cursor-pointer";
      card.onclick = () => openDressDetailModal(dress.id);

      const imgWrap = document.createElement('div');
      imgWrap.className = "relative overflow-hidden h-72 sm:h-80 md:h-96 bg-dark-950";
      
      const img = document.createElement('img');
      img.src = dress.image || 'https://via.placeholder.com/800x1000?text=loueys+Design';
      img.alt = getDressField(dress.title);
      img.loading = 'lazy';
      img.className = "w-full h-full object-cover object-top group-hover:scale-105 transition duration-700";
      img.onerror = function() { this.src = 'https://via.placeholder.com/800x1000?text=loueys+Design'; };
      
      const overlay = document.createElement('div');
      overlay.className = "absolute inset-0 bg-gradient-to-t from-dark-950 via-transparent to-transparent opacity-90";
      
      const priceBadge = document.createElement('span');
      priceBadge.className = "absolute top-3 left-3 bg-dark-950/80 backdrop-blur-md text-gold-400 font-bold px-2.5 py-1 rounded-full text-[11px] border border-gold-500/30 tracking-wider";
      priceBadge.textContent = `$${dress.price} USD`;

      const photosBadge = document.createElement('span');
      photosBadge.className = "absolute bottom-3 right-3 bg-black/70 text-gray-300 text-[10px] px-2 py-0.5 rounded-full border border-gold-500/20 flex items-center gap-1";
      const imgCount = (dress.images && dress.images.length) ? dress.images.length : 1;
      const photosSuffix = i18nData[currentLang]?.photos_count_suffix || 'صور';
      photosBadge.innerHTML = `<i class="fa-solid fa-camera text-gold-400 text-[9px]"></i> ${imgCount} ${photosSuffix}`;

      if (adminLoggedIn) {
        const deleteBtn = document.createElement('button');
        deleteBtn.className = "absolute top-3 right-3 bg-red-600 hover:bg-red-700 text-white font-bold p-2 rounded-full shadow-2xl transition flex items-center justify-center z-30 text-xs border border-red-400/50";
        deleteBtn.title = "حذف الفستان نهائياً";
        deleteBtn.innerHTML = '<i class="fa-solid fa-trash-can"></i>';
        deleteBtn.onclick = (e) => {
          e.stopPropagation();
          deleteDress(dress.id);
        };
        imgWrap.appendChild(deleteBtn);
      }

      imgWrap.appendChild(img);
      imgWrap.appendChild(overlay);
      imgWrap.appendChild(priceBadge);
      imgWrap.appendChild(photosBadge);

      const content = document.createElement('div');
      content.className = "p-4 space-y-2 flex-grow flex flex-col justify-between";

      const title = document.createElement('h3');
      title.className = "serif-title text-base sm:text-lg font-bold text-white mb-1 group-hover:text-gold-400 transition line-clamp-1";
      title.textContent = getDressField(dress.title);

      const desc = document.createElement('p');
      desc.className = "text-gray-400 text-[11px] leading-relaxed line-clamp-2";
      desc.textContent = getDressField(dress.description);

      const btn = document.createElement('button');
      btn.className = "w-full mt-2 bg-dark-800 hover:bg-gold-500 text-gold-400 hover:text-dark-950 border border-gold-600/40 font-bold py-2 rounded-lg transition duration-300 text-xs flex items-center justify-center gap-1 shadow";
      const btnText = i18nData[currentLang]?.btn_view_details || 'مشاهدة التفاصيل والصور';
      btn.innerHTML = `<i class="fa-solid fa-eye text-[10px]"></i> ${btnText}`;

      content.appendChild(title);
      content.appendChild(desc);
      content.appendChild(btn);

      card.appendChild(imgWrap);
      card.appendChild(content);
      return card;
    }

    function saveToStorage() {
      localStorage.setItem('louey_app_data', JSON.stringify(appData));
    }

    function filterCategory(cat, btn) {
      activeCategory = cat;
      document.querySelectorAll('.cat-btn').forEach(b => {
        b.className = "cat-btn bg-dark-900 text-gray-300 hover:text-gold-400 px-4 py-2 rounded-full border border-dark-800 transition whitespace-nowrap";
      });
      btn.className = "cat-btn active bg-gold-600 text-dark-950 font-bold px-4 py-2 rounded-full border border-gold-500 transition whitespace-nowrap";
      filterDresses();
    }

    function filterDresses() {
      const searchVal = document.getElementById('searchInput').value.toLowerCase().trim();
      const grid = document.getElementById('dressesGrid');
      const noRes = document.getElementById('noResultsMsg');
      grid.innerHTML = '';

      let matches = (appData.dresses || []).filter(d => {
        const titleMatch = getDressField(d.title).toLowerCase().includes(searchVal);
        const descMatch = getDressField(d.description).toLowerCase().includes(searchVal);
        const catMatch = activeCategory === 'all' || d.category === activeCategory;
        return (titleMatch || descMatch) && catMatch;
      });

      if (matches.length === 0) {
        noRes.classList.remove('hidden');
      } else {
        noRes.classList.add('hidden');
        matches.forEach(d => grid.appendChild(safeCreateDressCard(d)));
      }
    }

    function renderData() {
      document.getElementById('siteBrand').textContent = appData.siteTitle || "louey's Design";
      document.getElementById('heroTitle').textContent = appData.siteTitle || "louey's Design";
      document.getElementById('displayIban').textContent = appData.iban || '';

      if (appData.bgUrl) {
        document.getElementById('dynamicBgOverlay').style.backgroundImage = `url('${appData.bgUrl}')`;
      } else {
        document.getElementById('dynamicBgOverlay').style.backgroundImage = 'none';
      }

      const cleanWa = (appData.whatsapp || '').replace(/[^0-9]/g, '');
      const waConsultationMsg = encodeURIComponent(currentLang === 'en' ? "Hello louey's Design, I'd like a private consultation & custom fitting." : currentLang === 'tr' ? "Merhaba louey's Design, özel tasarım ve beden randevusu almak istiyorum." : "مرحباً دار louey's Design، أود حجز استشارة خاصة وتحديد المقاسات.");
      const waCustomSizeMsg = encodeURIComponent(currentLang === 'en' ? "Hello, I want to request a custom-fit dress tailoring." : currentLang === 'tr' ? "Merhaba, özel ölçülerime göre elbise dikimi talep etmek istiyorum." : "مرحباً، أرغب في تقديم طلب تفصيل فستان حسب مقاساتي الخاصة.");
      
      document.getElementById('designerConsultationBtn').href = `https://wa.me/${cleanWa}?text=${waConsultationMsg}`;
      document.getElementById('featureCustomSizeBtn').href = `https://wa.me/${cleanWa}?text=${waCustomSizeMsg}`;
      document.getElementById('featureConsultationBtn').href = `https://wa.me/${cleanWa}?text=${waConsultationMsg}`;

      document.getElementById('socialWhatsapp').href = `https://wa.me/${cleanWa}`;
      document.getElementById('socialInstagram').href = appData.instagram || '#';
      document.getElementById('socialFacebook').href = appData.facebook || '#';

      const toolbar = document.getElementById('adminToolbar');
      const quickAdd = document.getElementById('quickAddDressBtn');
      if (adminLoggedIn) {
        toolbar.classList.remove('hidden');
        quickAdd.classList.remove('hidden');
      } else {
        toolbar.classList.add('hidden');
        quickAdd.classList.add('hidden');
      }

      filterDresses();

      document.getElementById('settingSiteTitle').value = appData.siteTitle || '';
      document.getElementById('settingSubtitle').value = appData.subtitle || '';
      document.getElementById('settingIban').value = appData.iban || '';
      document.getElementById('settingWhatsapp').value = appData.whatsapp || '';
      document.getElementById('settingInstagram').value = appData.instagram || '';
      document.getElementById('settingFacebook').value = appData.facebook || '';
      document.getElementById('settingBgUrl').value = appData.bgUrl || '';
    }

    function openDressDetailModal(dressId) {
      selectedDress = (appData.dresses || []).find(x => x.id === dressId);
      if (!selectedDress) return;

      document.getElementById('modalDetailTitle').textContent = getDressField(selectedDress.title);
      document.getElementById('modalDetailPrice').textContent = `$${selectedDress.price} USD`;
      document.getElementById('modalDetailDesc').textContent = getDressField(selectedDress.description) || 'فستان سهرة فاخر مصمم بأجود الخامات العالمية.';

      const mainImg = document.getElementById('modalMainImg');
      const allImgs = (selectedDress.images && selectedDress.images.length > 0) ? selectedDress.images : [selectedDress.image];
      mainImg.src = allImgs[0];

      const thumbsContainer = document.getElementById('modalThumbnails');
      thumbsContainer.innerHTML = '';
      allImgs.forEach((imgUrl, idx) => {
        const thumb = document.createElement('img');
        thumb.src = imgUrl;
        thumb.className = `w-16 h-20 object-cover rounded-lg cursor-pointer border-2 transition ${idx === 0 ? 'border-gold-500 scale-95' : 'border-dark-700 opacity-70 hover:opacity-100'}`;
        thumb.onclick = () => {
          mainImg.src = imgUrl;
          Array.from(thumbsContainer.children).forEach(c => c.className = "w-16 h-20 object-cover rounded-lg cursor-pointer border-2 border-dark-700 opacity-70 hover:opacity-100 transition");
          thumb.className = "w-16 h-20 object-cover rounded-lg cursor-pointer border-2 border-gold-500 scale-95 transition";
        };
        thumbsContainer.appendChild(thumb);
      });

      const cleanWa = (appData.whatsapp || '').replace(/[^0-9]/g, '');
      const dressTitleText = getDressField(selectedDress.title);
      const detailWaMsg = encodeURIComponent(currentLang === 'en' ? `Hello louey's Design, I'd like to inquire about the dress (${dressTitleText}).` : currentLang === 'tr' ? `Merhaba louey's Design, (${dressTitleText}) elbisesi hakkında bilgi almak istiyorum.` : `مرحباً دار louey's Design، أود الاستفسار عن فستان (${dressTitleText}).`);
      document.getElementById('modalDetailWaBtn').href = `https://wa.me/${cleanWa}?text=${detailWaMsg}`;

      document.getElementById('dressDetailModal').classList.remove('hidden');
    }

    function closeDressDetailModal() {
      document.getElementById('dressDetailModal').classList.add('hidden');
    }

    function selectSize(size, btn) {
      selectedSize = size;
      document.querySelectorAll('.size-btn').forEach(b => {
        b.className = "size-btn px-3 py-1.5 rounded-lg border border-dark-700 bg-dark-950 text-gray-300 hover:border-gold-500";
      });
      btn.className = "size-btn px-3 py-1.5 rounded-lg border border-gold-500 bg-gold-600/20 text-gold-400 font-bold";
    }

    function proceedToPaymentFromDetail() {
      closeDressDetailModal();
      openPaymentModal(selectedDress.id);
    }

    function openPaymentModal(dressId) {
      selectedDress = (appData.dresses || []).find(x => x.id === dressId);
      if (!selectedDress) return;

      const dressTitleText = getDressField(selectedDress.title);
      document.getElementById('modalDressTitle').textContent = dressTitleText;
      document.getElementById('modalDressPrice').textContent = selectedDress.price;
      document.getElementById('ibanDressPrice').textContent = selectedDress.price;
      
      const sizeLabel = currentLang === 'en' ? 'Selected Size' : currentLang === 'tr' ? 'Seçilen Beden' : 'المقاس المختار';
      document.getElementById('selectedSizeDisplay').textContent = `${sizeLabel}: ${selectedSize}`;

      const cleanWa = (appData.whatsapp || '').replace(/[^0-9]/g, '');
      const waMsg = encodeURIComponent(currentLang === 'en' ? `Hello louey's Design, I'd like to order the dress (${dressTitleText}) size (${selectedSize}) priced $${selectedDress.price} USD.` : currentLang === 'tr' ? `Merhaba louey's Design, (${dressTitleText}) elbisesini (${selectedSize}) bedeninde $${selectedDress.price} USD tutarında sipariş etmek istiyorum.` : `مرحباً دار louey's Design، أرغب في طلب الفستان (${dressTitleText}) بالمقاس (${selectedSize}) وقيمته $${selectedDress.price} USD بعد إتمام التحويل.`);
      document.getElementById('whatsappIbanBtn').href = `https://wa.me/${cleanWa}?text=${waMsg}`;

      document.getElementById('paymentModal').classList.remove('hidden');
    }

    function closePaymentModal() { document.getElementById('paymentModal').classList.add('hidden'); }

    function copyIban() {
      const text = appData.iban || '';
      if (!text) return;
      navigator.clipboard?.writeText(text);
      const msg = currentLang === 'en' ? 'IBAN copied: ' : currentLang === 'tr' ? 'IBAN kopyalandı: ' : 'تم نسخ رقم IBAN: ';
      alert(msg + text);
    }

    function shareWebsiteLink() {
      if (navigator.share) {
        navigator.share({ title: appData.siteTitle, url: window.location.href });
      } else {
        navigator.clipboard?.writeText(window.location.href);
        const msg = currentLang === 'en' ? 'Website link copied!' : currentLang === 'tr' ? 'Site bağlantısı kopyalandı!' : 'تم نسخ رابط الموقع بنجاح!';
        alert(msg);
      }
    }

    function handleSecretClick() {
      window._secretClicks = (window._secretClicks || 0) + 1;
      if (window._secretClicks >= 5) {
        window._secretClicks = 0;
        openAdminModal(false);
      }
    }

    function openAdminModal(forceDashboard = false) {
      const modal = document.getElementById('adminModal');
      const loginView = document.getElementById('adminLoginView');
      const dashView = document.getElementById('adminDashboardView');

      modal.classList.remove('hidden');

      if (adminLoggedIn || forceDashboard) {
        loginView.classList.add('hidden');
        dashView.classList.remove('hidden');
      } else {
        loginView.classList.remove('hidden');
        dashView.classList.add('hidden');
      }
    }

    function closeAdminModal() { document.getElementById('adminModal').classList.add('hidden'); }

    function handleAdminLogin(evt) {
      evt.preventDefault();
      const pass = document.getElementById('adminPassInput').value.trim();
      if (!pass) return;

      if (pass === savedPass) {
        adminLoggedIn = true;
        document.getElementById('adminPassInput').value = '';
        document.getElementById('adminErrorMsg').classList.add('hidden');
        closeAdminModal();
        renderData();
      } else {
        document.getElementById('adminErrorMsg').classList.remove('hidden');
      }
    }

    function logoutAdmin() {
      adminLoggedIn = false;
      renderData();
    }

    function deleteDress(id) {
      if (!confirm('هل أنت متأكد من حذف هذا الفستان نهائياً؟')) return;
      appData.dresses = appData.dresses.filter(d => d.id !== id);
      saveToStorage();
      renderData();
    }

    // السلاح الفتاك: استيراد ورفع مئات الصور دفعة واحدة لإنشاء فساتين تلقائية
    function handleBulkImagesUpload(e) {
      const files = Array.from(e.target.files);
      if (files.length === 0) return;

      let addedCount = 0;
      files.forEach((file, index) => {
        if (file.size <= 3 * 1024 * 1024) {
          const reader = new FileReader();
          reader.onload = function(evt) {
            const imgData = evt.target.result;
            const dressId = Date.now() + index;
            const newDress = {
              id: dressId,
              category: "royal",
              title: {
                ar: `فستان سهرة حصري #${dressId.toString().slice(-4)}`,
                en: `Exclusive Gown #${dressId.toString().slice(-4)}`,
                tr: `Özel Tasarım Elbise #${dressId.toString().slice(-4)}`
              },
              price: 400 + (index % 5) * 50,
              image: imgData,
              images: [imgData],
              description: {
                ar: "تصميم ملوكي فاخر مصمم بالكامل بأجود خامات الحرير والتطريز اليدوي.",
                en: "Luxurious haute couture gown crafted with fine silk and hand embroidery.",
                tr: "El işlemeli ve özel ipek kumaştan üretilmiş lüks tasarım."
              }
            };
            appData.dresses.unshift(newDress);
            addedCount++;
            if (addedCount === files.length) {
              saveToStorage();
              renderData();
              alert(`تم رفع وتوليد ${addedCount} فستان بنجاح في المعرض!`);
            }
          };
          reader.readAsDataURL(file);
        }
      });
    }

    function handleDressMultiFilesSelect(e) {
      const files = Array.from(e.target.files);
      if (files.length === 0) return;

      tempDressImagesBase64 = [];
      document.getElementById('selectedFileName').textContent = `تم اختيار ${files.length} صور`;

      files.forEach(file => {
        if (file.size <= 2 * 1024 * 1024) {
          const reader = new FileReader();
          reader.onload = function(evt) {
            tempDressImagesBase64.push(evt.target.result);
          };
          reader.readAsDataURL(file);
        }
      });
    }

    function addNewDress() {
      const nameAr = document.getElementById('newDressNameAr').value.trim();
      const nameEn = document.getElementById('newDressNameEn').value.trim();
      const nameTr = document.getElementById('newDressNameTr').value.trim();

      const price = parseFloat(document.getElementById('newDressPrice').value);
      
      const descAr = document.getElementById('newDressDescAr').value.trim();
      const descEn = document.getElementById('newDressDescEn').value.trim();
      const descTr = document.getElementById('newDressDescTr').value.trim();

      const imageUrlInput = document.getElementById('newDressImage').value.trim();

      if (!nameAr || isNaN(price)) return alert('يرجى كِتابة اسم الفستان بالعربية والسعر بالدولار.');

      const mainImg = tempDressImagesBase64[0] || imageUrlInput || 'https://images.unsplash.com/photo-1566174053879-31528523f8ae?auto=format&fit=crop&w=800&q=80';
      const allImgs = (tempDressImagesBase64.length > 0) ? tempDressImagesBase64 : [mainImg];

      const newDress = {
        id: Date.now(),
        category: "royal",
        title: {
          ar: nameAr,
          en: nameEn || nameAr,
          tr: nameTr || nameAr
        },
        price: price,
        image: mainImg,
        images: allImgs,
        description: {
          ar: descAr || 'تصميم فاخر من مجموعات الدار المصممة بأجود أنواع الحرير والدانتيل.',
          en: descEn || descAr || 'Luxurious haute couture gown designed with premium silk and lace.',
          tr: descTr || descAr || 'İpek ve dantelden yapılmış lüks gece elbisesi.'
        }
      };

      appData.dresses.unshift(newDress);
      saveToStorage();

      document.getElementById('newDressNameAr').value = '';
      document.getElementById('newDressNameEn').value = '';
      document.getElementById('newDressNameTr').value = '';
      document.getElementById('newDressPrice').value = '';
      document.getElementById('newDressDescAr').value = '';
      document.getElementById('newDressDescEn').value = '';
      document.getElementById('newDressDescTr').value = '';
      document.getElementById('newDressImage').value = '';
      document.getElementById('selectedFileName').textContent = '';
      tempDressImagesBase64 = [];

      renderData();
      closeAdminModal();
      alert('تمت إضافة الفستان ومجموعة صوره بنجاح!');
    }

    function changeAdminPassword() {
      const oldPassword = document.getElementById('oldPasswordInput').value.trim();
      const newPassword = document.getElementById('newPasswordInput').value.trim();

      if (!oldPassword || !newPassword) return alert('يرجى ملء حقول كلمة السر.');

      if (oldPassword === savedPass) {
        savedPass = newPassword;
        localStorage.setItem('louey_admin_pass', newPassword);
        alert('تم تحديث كلمة السر بنجاح!');
        document.getElementById('oldPasswordInput').value = '';
        document.getElementById('newPasswordInput').value = '';
      } else {
        alert('كلمة السر الحالية غير صحيحة.');
      }
    }

    function saveGeneralSettings() {
      appData.siteTitle = document.getElementById('settingSiteTitle').value.trim();
      appData.subtitle = document.getElementById('settingSubtitle').value.trim();
      appData.iban = document.getElementById('settingIban').value.trim();
      appData.whatsapp = document.getElementById('settingWhatsapp').value.trim();
      appData.instagram = document.getElementById('settingInstagram').value.trim();
      appData.facebook = document.getElementById('settingFacebook').value.trim();
      appData.bgUrl = document.getElementById('settingBgUrl').value.trim();

      saveToStorage();
      renderData();
      closeAdminModal();
      alert('تم حفظ كافة الإعدادات بنجاح!');
    }

    function handleBgFileUpload(event) {
      const file = event.target.files[0];
      if (!file) return;
      if (file.size > 2 * 1024 * 1024) return alert('اختر صورة أصغر من 2 ميجابايت.');
      const r = new FileReader();
      r.onload = e => { document.getElementById('settingBgUrl').value = e.target.result; };
      r.readAsDataURL(file);
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('year').textContent = new Date().getFullYear();
      renderData();
    });
  </script>
</body>
</html>

