        }
      ]
    };

    let selectedDress = null;
    let selectedSize = "M";
    let adminLoggedIn = false;
    let tempDressImagesBase64 = [];

    const i18nData = {
      ar: {
        nav_home: "الرئيسية", nav_gallery: "المعرض الشامل", nav_features: "مميزات الدار", nav_about: "عن الدار", nav_contact: "تواصل معنا",
